# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# MongoDB Atlas connection string. Example:
# mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aqi_aggregator?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aqi_aggregator?retryWrites=true&w=majority
# ---- Auth ----
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ---- CORS ----
FRONTEND_ORIGIN=http://localhost:5173

# ---- OpenAQ (https://openaq.org) ----
# Free API key: register at https://explore.openaq.org/register, then copy the key from your account settings.
# Required - without it no air-quality data is loaded (nothing is simulated).
OPENAQ_API_KEY=your_openaq_api_key
# Worldwide by default. Optional: limit to some countries (ISO codes), e.g. OPENAQ_COUNTRIES=IN,US,GB
OPENAQ_COUNTRIES=
# Stations taken per country, and the overall cap (keeps you inside OpenAQ's 60 requests/min and 2,000/hour)
OPENAQ_STATIONS_PER_COUNTRY=3
OPENAQ_MAX_STATIONS=300
# Ignore sensor readings older than this many hours
OPENAQ_MAX_AGE_HOURS=3
# Minimum pollutants needed to publish an AQI (PM2.5 or PM10 is always needed).
# 1 keeps stations that report only PM; the official CPCB rule is 3.
AQI_MIN_POLLUTANTS=1
# auto = India uses the Indian CPCB AQI, every other country uses the US EPA AQI.
# Or force one scale for all stations: CPCB | US_EPA
AQI_STANDARD=auto

# ---- Ingestion ----
# Refresh interval. 300 stations x 1 request each x 2 per hour fits the 2,000/hour limit.
AQI_POLL_CRON=*/30 * * * *
